# Server
PORT=5000

# MongoDB connection string. Use your own local or hosted database.
MONGODB_URI=mongodb://127.0.0.1:27017/moneo

# Generate a strong secret (at least 32 characters); never commit the real value.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters

# Google Gemini (optional until AI insights are used)
GEMINI_API_KEY=

# SMTP for password-reset email. Use a provider app password stored only in your deployment environment.
SMTP_USER=
SMTP_APP_PASSWORD=
